# ============================================================================
# UniSphere Root .gitignore
# ============================================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
campusflow/node_modules/
campusflow/frontend/node_modules/
campusflow/backend/node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (Keep ignored, never commit credentials)
.env
frontend/.env
backend/.env
campusflow/.env
campusflow/frontend/.env
campusflow/backend/.env
**/.env
**/.env.*
!**/.env.example

# Production Builds & Distribution
dist/
frontend/dist/
backend/dist/
campusflow/dist/
campusflow/frontend/dist/
campusflow/backend/dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
out/
**/out/

# Logs & Debugging
*.log
**/*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Files
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Configurations
.vscode/
**/.vscode/
.idea/
**/.idea/
*.sublime-project
*.sublime-workspace

# Docker & Temporary Files
*.tmp
**/*.tmp
temp/
tmp/
**/temp/
**/tmp/
